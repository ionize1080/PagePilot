<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="#F5F7FB" TextElement.FontFamily="Microsoft YaHei UI" TextElement.FontSize="13" TextElement.Foreground="#1E293B">
<Grid.Resources>
<Style TargetType="Button"><Setter Property="Padding" Value="12,9"/><Setter Property="Margin" Value="0,0,8,0"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="#334155"/><Setter Property="BorderBrush" Value="#DCE3EF"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="B" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Opacity" Value="0.8"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="B" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
<Style TargetType="TextBox"><Setter Property="Padding" Value="10,8"/><Setter Property="BorderBrush" Value="#DCE3EF"/><Setter Property="Background" Value="White"/><Setter Property="FontSize" Value="14"/></Style>
<Style TargetType="ListBox"><Setter Property="Background" Value="White"/><Setter Property="BorderThickness" Value="0"/><Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/></Style>
<Style TargetType="ListBoxItem"><Setter Property="Padding" Value="10,10"/><Setter Property="Margin" Value="0,1"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style>
<Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
</Grid.Resources><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<Grid Margin="14,12,14,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="文档目录" FontSize="17" FontWeight="SemiBold"/><Button x:Name="Settings" Grid.Column="1" Content="⚙" Padding="6,3" Margin="0" ToolTip="导航与外观设置"/></Grid>
<Grid Grid.Row="1" Margin="10,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<WrapPanel Margin="4,0,0,8"><Button x:Name="Refresh" Content="刷新" Padding="9,4"/><Button x:Name="Apply" Content="应用大纲" ToolTip="将当前目录层级写入 Word 大纲，直接应用并备份" Padding="9,4"/></WrapPanel>
<TreeView x:Name="Headings" Grid.Row="1" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="文档目录"/>
<Expander Grid.Row="2" Header="AI 目录要求" Margin="4,10,4,6"><StackPanel Margin="0,8,0,0"><TextBox x:Name="AiRequirement" Text="识别全部标题层级" AcceptsReturn="True" TextWrapping="Wrap" Height="62"/><Button x:Name="Analyze" Content="交给 AI 识别 ↗" Padding="8,6" Margin="0,8,0,0"/><TextBlock Text="例如：只识别大标题，或识别至三级。" FontSize="11" Foreground="#64748B" Margin="0,6,0,0"/></StackPanel></Expander></Grid>
<Border Grid.Row="2" Padding="14,9" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0"><TextBlock x:Name="Status" Text="单击标题开始阅读" Foreground="#64748B" FontSize="11"/></Border></Grid>