<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="{DynamicResource Canvas}" TextElement.FontFamily="Microsoft YaHei UI" TextElement.FontSize="13" TextElement.Foreground="{DynamicResource Ink}">
<Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<Grid Margin="18,18,14,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="文档目录" FontSize="18" FontWeight="SemiBold"/><Button x:Name="Settings" Grid.Column="1" Content="⚙" Padding="6,3" Margin="0" ToolTip="导航与外观设置"/></Grid>
<Grid Grid.Row="1" Margin="10,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<WrapPanel Margin="4,0,0,8"><Button x:Name="Refresh" Content="分析目录" Padding="9,4"/><Button x:Name="StopScan" Content="取消" Visibility="Collapsed" Padding="9,4"/><Button x:Name="Apply" Content="应用大纲" ToolTip="将当前目录层级写入 Word 大纲，直接应用并备份" Padding="9,4"/></WrapPanel>
<TreeView x:Name="Headings" Grid.Row="1" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingStackPanel.IsVirtualizing="True" VirtualizingStackPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True" AutomationProperties.Name="文档目录"/>
<Expander Grid.Row="2" Header="AI 目录要求" Margin="4,10,4,6"><StackPanel Margin="0,8,0,0"><TextBox x:Name="AiRequirement" Text="识别全部标题层级" AcceptsReturn="True" TextWrapping="Wrap" Height="62"/><CheckBox x:Name="NavigationAutomatic" IsChecked="True" Content="识别完成后更新目录" ToolTip="仅更新侧栏目录；关闭后手动确认" Margin="0,8,0,0"/><Button x:Name="Analyze" Content="AI 识别" Padding="8,6" Margin="0,8,0,0"/><TextBlock Text="例如：只识别大标题，或识别至三级。" FontSize="11" Foreground="{DynamicResource Muted}" Margin="0,6,0,0"/></StackPanel></Expander></Grid>
<Border Grid.Row="2" Padding="14,9" BorderBrush="{DynamicResource Line}" BorderThickness="{DynamicResource FooterLine}"><StackPanel><ProgressBar x:Name="WorkProgress" Visibility="Collapsed" Height="3" Margin="0,0,0,8" Foreground="{DynamicResource Accent}" Background="{DynamicResource Line}"/><TextBlock x:Name="Status" Text="单击标题开始阅读" Foreground="{DynamicResource Muted}" FontSize="11"/></StackPanel></Border></Grid>