<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="#F5F7FB" TextElement.FontFamily="Microsoft YaHei UI" TextElement.FontSize="13" TextElement.Foreground="#1E293B">
<Grid.Resources>
<Style TargetType="Button"><Setter Property="Padding" Value="12,9"/><Setter Property="Margin" Value="0,0,8,0"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="#334155"/><Setter Property="BorderBrush" Value="#DCE3EF"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="B" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Opacity" Value="0.8"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="B" Property="BorderBrush" Value="#2563EB"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
<Style TargetType="TextBox"><Setter Property="Padding" Value="10,8"/><Setter Property="BorderBrush" Value="#DCE3EF"/><Setter Property="Background" Value="White"/><Setter Property="FontSize" Value="14"/></Style>
<Style TargetType="ListBox"><Setter Property="Background" Value="White"/><Setter Property="BorderThickness" Value="0"/><Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/></Style>
<Style TargetType="ListBoxItem"><Setter Property="Padding" Value="10,10"/><Setter Property="Margin" Value="0,1"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style>
<Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
</Grid.Resources><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid Margin="18,18,14,16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="☷   自动导航" FontSize="20" FontWeight="SemiBold" Foreground="#1D4ED8"/><TextBlock Text="理解结构 · 保留原貌" Margin="0,7,0,0" Foreground="#64748B" FontSize="12"/></StackPanel><Button Grid.Column="1" x:Name="Settings" Content="⚙" ToolTip="打开 PagePilot 设置" Padding="9,5" VerticalAlignment="Top" Margin="8,0,0,0"/></Grid><Grid Grid.Row="1" Margin="18,0,18,16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<StackPanel><Border Background="#EAF1FF" CornerRadius="8" Padding="12" Margin="0,0,0,16"><TextBlock Text="自动识别标题，像书签一样跳转。不会修改文档文字、样式或大纲级别。" Foreground="#47618D" FontSize="12"/></Border><UniformGrid Columns="2"><Button x:Name="Refresh" Content="本地识别" Background="#2563EB" Foreground="White" BorderBrush="#2563EB"/><Button x:Name="Analyze" Content="AI 分析" Margin="0"/></UniformGrid><TextBlock Text="文档结构" FontWeight="SemiBold" Margin="0,22,0,10"/></StackPanel>
<Border Grid.Row="1" Background="White" CornerRadius="9" BorderThickness="1" BorderBrush="#E2E8F0" Padding="4"><ListBox x:Name="Headings" AutomationProperties.Name="文档结构"/></Border>
<StackPanel Grid.Row="2" Margin="0,16,0,0"><Button x:Name="Apply" Content="应用到 Word 原生导航" Margin="0"/><TextBlock Text="此操作会修改大纲级别，执行前需批准。" FontSize="11" Foreground="#94A3B8" Margin="0,8,0,0"/></StackPanel></Grid><Border Grid.Row="2" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="18,12" Background="White"><TextBlock x:Name="Status" Text="准备就绪" Foreground="#64748B" FontSize="12"/></Border></Grid>