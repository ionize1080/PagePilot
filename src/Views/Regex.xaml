<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="#F5F7FB" TextElement.FontFamily="Microsoft YaHei UI" TextElement.FontSize="13" TextElement.Foreground="#1E293B">
<Grid.Resources>
<Style TargetType="Button"><Setter Property="Padding" Value="12,9"/><Setter Property="Margin" Value="0,0,8,0"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="#334155"/><Setter Property="BorderBrush" Value="#DCE3EF"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="B" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Opacity" Value="0.8"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="B" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
<Style TargetType="TextBox"><Setter Property="Padding" Value="10,8"/><Setter Property="BorderBrush" Value="#DCE3EF"/><Setter Property="Background" Value="White"/><Setter Property="FontSize" Value="14"/></Style>
<Style TargetType="ListBox"><Setter Property="Background" Value="White"/><Setter Property="BorderThickness" Value="0"/><Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/></Style>
<Style TargetType="ListBoxItem"><Setter Property="Padding" Value="10,10"/><Setter Property="Margin" Value="0,1"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style>
<Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
</Grid.Resources><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid Margin="18,18,14,16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="正则替换" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource Accent}"/><TextBlock Text="精确查找 · 预览后替换" Margin="0,7,0,0" Foreground="#64748B" FontSize="12"/></StackPanel><Button Grid.Column="1" x:Name="Settings" Content="⚙" ToolTip="打开 PagePilot 设置" Padding="9,5" VerticalAlignment="Top" Margin="8,0,0,0"/></Grid><Grid Grid.Row="1" Margin="18,0,18,16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
<StackPanel><TextBlock Text="查找表达式" Margin="0,0,0,7" FontWeight="SemiBold"/><TextBox x:Name="Pattern" AutomationProperties.Name="正则表达式" FontFamily="Consolas"/>
<TextBlock Text="替换为" Margin="0,16,0,7" FontWeight="SemiBold"/><TextBox x:Name="Replacement" AutomationProperties.Name="替换内容" FontFamily="Consolas"/><TextBlock Text="支持 $1、${组名} 捕获组" Foreground="#94A3B8" FontSize="11" Margin="0,6,0,12"/>
<WrapPanel Margin="0,0,0,16"><CheckBox x:Name="IgnoreCase" Content="忽略大小写" Margin="0,0,20,8"/><CheckBox x:Name="SelectionOnly" Content="仅选中范围" Margin="0,0,0,8"/></WrapPanel>
<UniformGrid Columns="2"><Button x:Name="Preview" Content="查找预览" Background="{DynamicResource Accent}" Foreground="White" BorderBrush="{DynamicResource Accent}"/><Button x:Name="Replace" Content="替换全部" Margin="0"/></UniformGrid>
<TextBlock Text="匹配结果" FontWeight="SemiBold" Margin="0,22,0,10"/></StackPanel>
<Border Grid.Row="1" Background="White" CornerRadius="9" BorderThickness="1" BorderBrush="#E2E8F0" Padding="4"><ListBox x:Name="Matches" AutomationProperties.Name="匹配结果"/></Border></Grid><Border Grid.Row="2" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="18,12" Background="White"><TextBlock x:Name="Status" Text="准备就绪" Foreground="#64748B" FontSize="12"/></Border></Grid>