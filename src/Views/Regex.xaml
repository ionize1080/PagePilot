<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="{DynamicResource Canvas}" TextElement.FontFamily="Microsoft YaHei UI" TextElement.FontSize="13" TextElement.Foreground="{DynamicResource Ink}">
<Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid Margin="18,18,14,16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="正则替换" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource Accent}"/><TextBlock Text="输入即查找 · 单击跳转 · 一步撤销" Margin="0,7,0,0" Foreground="{DynamicResource Muted}" FontSize="12"/></StackPanel><Button Grid.Column="1" x:Name="Settings" Content="⚙" ToolTip="打开 PagePilot 设置" Padding="9,5" VerticalAlignment="Top" Margin="8,0,0,0"/></Grid><Grid Grid.Row="1" Margin="18,0,18,16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
<StackPanel><TextBlock Text="查找表达式" Margin="0,0,0,7" FontWeight="SemiBold"/><TextBox x:Name="Pattern" AutomationProperties.Name="正则表达式" FontFamily="Consolas"/>
<TextBlock Text="替换为" Margin="0,16,0,7" FontWeight="SemiBold"/><TextBox x:Name="Replacement" AutomationProperties.Name="替换内容" FontFamily="Consolas"/><TextBlock Text="支持 $1、${组名} 捕获组" Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,6,0,12"/>
<WrapPanel Margin="0,0,0,16"><CheckBox x:Name="IgnoreCase" Content="忽略大小写" Margin="0,0,20,8"/><CheckBox x:Name="SelectionOnly" Content="仅选中范围" Margin="0,0,0,8"/></WrapPanel>
<UniformGrid Columns="2"><Button x:Name="Preview" Content="查找预览" Background="{DynamicResource Accent}" Foreground="{DynamicResource AccentInk}" BorderBrush="{DynamicResource Accent}"/><Button x:Name="Replace" Content="替换全部" Margin="0"/></UniformGrid>
<TextBlock Text="匹配结果" FontWeight="SemiBold" Margin="0,22,0,10"/></StackPanel>
<Border Grid.Row="1" Background="{DynamicResource Surface}" CornerRadius="9" BorderThickness="1" BorderBrush="{DynamicResource Line}" Padding="4"><ListBox VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True" x:Name="Matches" AutomationProperties.Name="匹配结果"><ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Before}" FontFamily="Consolas" FontSize="13" MaxHeight="42" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding After, StringFormat=→ {0}}" FontSize="12" Opacity="0.8" Margin="0,5,0,0" MaxHeight="38" TextTrimming="CharacterEllipsis"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox></Border></Grid><Border Grid.Row="2" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="18,12" Background="{DynamicResource Surface}"><TextBlock x:Name="Status" Text="准备就绪" Foreground="{DynamicResource Muted}" FontSize="12"/></Border></Grid>