<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework><UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion><AssemblyName>PagePilot</AssemblyName>
    <Version>0.4.4</Version><GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Platforms>AnyCPU</Platforms>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../shared/RuntimeSettings.cs" Link="RuntimeSettings.cs" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <Reference Include="Office"><HintPath>$(OfficePiaPath)</HintPath><EmbedInteropTypes>true</EmbedInteropTypes><Private>false</Private></Reference>
    <Reference Include="Extensibility"><HintPath>C:\Program Files (x86)\Common Files\Microsoft Shared\MSEnv\PublicAssemblies\extensibility.dll</HintPath><EmbedInteropTypes>true</EmbedInteropTypes><Private>false</Private></Reference>
    <Reference Include="System.Xml.Linq"/><Reference Include="System.Net.Http"/><Reference Include="Microsoft.CSharp"/><Reference Include="System.Web.Extensions"/>
    <Reference Include="WindowsBase"/><Reference Include="PresentationCore"/><Reference Include="PresentationFramework"/><Reference Include="System.Xaml"/><Reference Include="WindowsFormsIntegration"/>
    <EmbeddedResource Include="Views\*.xaml" />
  </ItemGroup>
</Project>
